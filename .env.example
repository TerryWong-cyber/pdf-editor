PDF_EDITOR_DATA_DIR=./data
PDF_EDITOR_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
PDF_EDITOR_MAX_UPLOAD_MB=100

# MCP endpoint: /mcp/ (Streamable HTTP). Unauthenticated mode is for local use only.
PDF_EDITOR_MCP_ENABLED=true
PDF_EDITOR_MCP_MAX_CONCURRENCY=2
# JSON mapping of stable identity names to distinct high-entropy Bearer secrets.
# Empty mapping keeps the existing local REST workflow. When configured, BOTH REST
# and MCP require auth, and each identity gets an isolated file/draft namespace.
PDF_EDITOR_API_KEYS={}
# External base URL including reverse-proxy prefix, e.g. https://example.com/pdf-editor
# Also authorizes this URL's Host for MCP DNS-rebinding protection.
PDF_EDITOR_PUBLIC_BASE_URL=

FONT_FILE=/usr/share/fonts/opentype/noto/NotoSansSC-VF.ttf
FONT_ZH_FILE=/usr/share/fonts/opentype/noto/NotoSansSC-VF.ttf
FONT_ZH_CN_FILE=/usr/share/fonts/opentype/noto/NotoSansSC-VF.ttf
FONT_ZH_TW_FILE=/usr/share/fonts/opentype/noto/NotoSansTC-VF.ttf
FONT_LATIN_FILE=/usr/share/fonts/opentype/noto/NotoSans-VF.ttf
FONT_JA_FILE=/usr/share/fonts/opentype/noto/NotoSansJP-VF.ttf
FONT_KO_FILE=/usr/share/fonts/opentype/noto/NotoSansKR-VF.ttf
FONT_ARABIC_FILE=/usr/share/fonts/opentype/noto/NotoSansArabic-VF.ttf
FONT_CYRILLIC_FILE=/usr/share/fonts/opentype/noto/NotoSans-VF.ttf
FONT_THAI_FILE=/usr/share/fonts/opentype/noto/NotoSansThai-VF.ttf
FONT_VIETNAMESE_FILE=/usr/share/fonts/opentype/noto/NotoSans-VF.ttf

# URL imports: JSON list of exact private hosts, empty allows public HTTP(S) only.
PDF_EDITOR_URL_IMPORT_ALLOWED_HOSTS=[]
PDF_EDITOR_URL_IMPORT_TIMEOUT_SECONDS=120
# Portable export URLs; set a shared random signing key (>=32 characters) for persistent links.
PDF_EDITOR_DOWNLOAD_URL_TTL_SECONDS=3600
PDF_EDITOR_DOWNLOAD_SIGNING_KEY=
